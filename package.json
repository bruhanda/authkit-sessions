{
  "name": "@authkit/sessions",
  "version": "0.1.0",
  "description": "Universal, TypeScript-first, edge-runtime-native session layer with pluggable storage adapters. <6KB gzipped, runs in Node, Bun, Deno, Cloudflare Workers and Vercel Edge. Lucia-deprecation alternative with instant revoke, concurrent session limits and device tracking.",
  "license": "MIT",
  "author": "Vasyl Bruhanda",
  "homepage": "https://github.com/bruhanda/authkit-sessions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruhanda/authkit-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/bruhanda/authkit-sessions/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory/index.d.ts",
      "import": "./dist/adapters/memory/index.js"
    },
