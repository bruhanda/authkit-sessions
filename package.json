  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack .",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run publint && npm run attw && npm run size"
